EESchema-LIBRARY Version 2.4
#encoding utf-8
#
# Hand-written fixture for test/kicad-import.test.js. Same shape a KiCad 4/5
# project's <name>-cache.lib has: the schematic references these symbols and
# keeps NO pin geometry of its own.
#
# Device_R
#
DEF Device_R R 0 0 N Y 1 F N
F0 "R" 80 0 50 V V C CNN
F1 "Device_R" 0 0 50 V V C CNN
DRAW
S -40 -100 40 100 0 1 10 N
X ~ 1 0 150 50 D 50 50 1 1 P
X ~ 2 0 -150 50 U 50 50 1 1 P
ENDDRAW
ENDDEF
#
# power_GND
#
DEF power_GND #PWR 0 0 Y Y 1 F P
F0 "#PWR" 0 -250 50 H I C CNN
F1 "power_GND" 0 -150 50 H V C CNN
DRAW
X GND 1 0 0 0 D 50 50 1 1 W N
ENDDRAW
ENDDEF
#
# power_+5V
#
DEF power_+5V #PWR 0 0 Y Y 1 F P
F0 "#PWR" 0 -150 50 H I C CNN
F1 "power_+5V" 0 140 50 H V C CNN
DRAW
X +5V 1 0 0 0 U 50 50 1 1 W N
ENDDRAW
ENDDEF
#
# Switch_SW_DPDT
#   Two units, with the same pin GEOMETRY in each -- which is how KiCad draws
#   a DPDT, and why the unit field matters so much. Pins 4-6 belong to unit 2
#   and must NOT appear on the unit-1 placement in the fixture schematic: the
#   X record keeps the unit in field 9, and reading field 10 (the body style)
#   instead hands every unit the whole package, landing pins 4-6 on exactly
#   the wires that pins 1-3 sit on.
#
DEF Switch_SW_DPDT SW 0 0 Y N 2 F N
F0 "SW" 0 200 50 H V C CNN
F1 "Switch_SW_DPDT" 0 -200 50 H V C CNN
DRAW
X A 1 200 100 100 L 50 50 1 1 P
X B 2 -200 0 100 R 50 50 1 1 P
X C 3 200 -100 100 L 50 50 1 1 P
X A 4 200 100 100 L 50 50 2 1 P
X B 5 -200 0 100 R 50 50 2 1 P
X C 6 200 -100 100 L 50 50 2 1 P
ENDDRAW
ENDDEF
#
#End Library
