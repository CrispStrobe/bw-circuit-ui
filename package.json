{
  "name": "bw-circuit-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Circuit designer UI for Brickwright",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test test/engine-injection.test.js test/circuit.test.js test/interaction.test.js test/simulation.test.js test/inference.test.js test/multimeter.test.js test/buzzer-audio.test.js test/probe-placement.test.js test/snap-grid.test.js test/history.test.js test/params.test.js test/integration-path.test.js",
    "test:render": "node --test test/rendering.test.js",
    "test:all": "npm test && npm run test:render"
  },
  "author": "CrispStrobe <cze+github@mailbox.org>",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@wokwi/elements": "^1.9.2",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.2.1"
  }
}
